    <a href={processID("Layers Inside a Component")}>Layers inside a component</a>
    <a href={processID("How Stacking Works")}>How stacking works</a>
    <a href={processID("Your Own Overlays")}>Your own overlays</a>
  {/snippet}

</DocLayout>
