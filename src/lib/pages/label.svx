dir: ".lib/pages"
tags: [label, form-label, form, component, svelte, svelte-5, theui-svelte, component-library, ui, tailwindcss]
---

<script lang="ts">
  import DocLayout from "#lib/ui/doc/DocLayout.svelte";
  import DocHead from "#lib/ui/doc/Head.svelte";
  import DocBlock from "#lib/ui/doc/Block.svelte";
  import Code from "#lib/ui/doc/CodeBlock.svelte";
  import Example from "#lib/ui/doc/Example.svelte";
  import ConfigComponent from "#lib/ui/doc/ConfigComponent.svelte";
  import { processID, editURL } from "#lib";
  let { component }: {component: any } = $props();

  import { Label } from "theui-svelte";
</script>

<DocLayout>
  <DocHead title="Label" text="A form label that matches the other form components and takes its classes from the Form or Fieldset around it. It accepts any content." edit_url={editURL("label")} />

  <DocBlock title="About">
    <p class="not-prose">The <code>Label</code> component is designed to simplify the creation of form labels while maintaining consistency in styling and functionality. It renders a native <code>&lt;label&gt;</code> element with the library's label styles. The form inputs, like <code>Input</code>, <code>Checkbox</code> and <code>Toggle</code>, use it internally, and you can use it directly when you build a custom field.</p>
  </DocBlock>

  <DocBlock title="Example">
    <Example>
      <p class="not-prose">To use the <b>Label</b> component, import it, place the label text inside it, and set the <code>for</code> attribute to the <code>id</code> of the input it describes. Here's a basic example:</p>
      {#snippet example()}
        <div class="flex flex-col gap-2">
          <Label for="label-example-username">Username</Label>
          <input id="label-example-username" class="border rounded-md px-3 py-2" />
        </div>
      {/snippet}
      {#snippet code()}

```html
<script>
  import { Label } from "theui-svelte";
</script>

<Label for="username">Username</Label>
<input id="username" />
```
      {/snippet}
    </Example>
    <p class="not-prose">In this example, a label with the text "Username" is rendered and associated with the input through the <code>for</code> attribute. Inside a <code>Fieldset</code> or <code>Form</code>, the label uses their shared settings, like <code>size</code> and <code>reset</code>. Floating labels are only used by the <code>Input</code> and <code>Select</code> components, so a standalone <code>Label</code> never floats, even in a form with floating labels.</p>
  </DocBlock>

  <DocBlock title="Label Content">
    <Example>
      <p class="not-prose">Everything placed inside the <code>Label</code> component becomes its content. It can be plain text or any mix of elements and components, like icons or badges. A <code>Label</code> without content renders nothing.</p>
      {#snippet example()}
        <Label for="label-example-email"><strong>Email</strong>&nbsp;Address</Label>
      {/snippet}
      {#snippet code()}

```html
<!-- Text label -->
<Label for="username">Username</Label>

<!-- Label with elements -->
<Label for="email"><strong>Email</strong> Address</Label>
```
      {/snippet}
    </Example>
  </DocBlock>

  <DocBlock title="Customization">
    <Example>
      <p class="not-prose">The <code>Label</code> component can be easily customized using the native <code>class</code> attribute. By adding your own CSS classes or the <b>TailwindCSS</b>, you can override or extend the default styles of the label to match your design requirements. Any other attributes you add are passed to the <code>&lt;label&gt;</code> element.</p>
      {#snippet example()}
        <Label for="label-example-custom" class="text-brand-500 font-bold text-lg">Username</Label>
      {/snippet}
      {#snippet code()}

```html
<Label for="username" class="text-brand-500 font-bold text-lg">Username</Label>
```
      {/snippet}
    </Example>
  </DocBlock>

  <DocBlock title="Accessibility">
    <p class="not-prose">The <code>Label</code> component is based on the native <code>&lt;label&gt;</code> element, which improves accessibility by providing an associated label for form elements. Connect it to the input by setting its <code>for</code> attribute to the input's <code>id</code> (the form inputs of this library do this for you). This makes it easier for users, especially those using screen readers, to understand what each input is for. The label also increases the clickable area, improving the user experience.</p>
  </DocBlock>

  <DocBlock title="Configuration">
    <ConfigComponent {component} />
  </DocBlock>

